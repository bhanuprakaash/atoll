#!/bin/sh
set -eu
if [ "$(uname -s)" != Linux ]; then
    exec "$@"
fi
if [ "${ATOLL_E2E_SECRET_SESSION:-}" != 1 ]; then
    exec dbus-run-session -- env ATOLL_E2E_SECRET_SESSION=1 "$0" "$@"
fi
# A private encrypted login collection needs no display or interactive unlock prompt.
secret_home=$(mktemp -d)
trap 'rm -rf "$secret_home"' EXIT HUP INT TERM
export XDG_DATA_HOME="$secret_home/data" XDG_RUNTIME_DIR="$secret_home/run"
mkdir -p "$XDG_DATA_HOME" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
printf 'e2e-keyring-password\n' | gnome-keyring-daemon --unlock --components=secrets >/dev/null
printf %s atoll-secret-probe | secret-tool store --label=atoll-e2e service atoll-e2e account probe
test "$(secret-tool lookup service atoll-e2e account probe)" = atoll-secret-probe
secret-tool clear service atoll-e2e account probe
echo 'Secret Service store/lookup/clear passed'
"$@"
